{
  // LaTeX Workshop: build paper/paper.tex with Tectonic on every save; PDF opens in a VS Code tab.
  "latex-workshop.latex.tools": [
    {
      "name": "tectonic",
      "command": "/opt/homebrew/bin/tectonic",
      "args": ["--synctex", "--keep-logs", "%DOC%.tex"],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "tectonic", "tools": ["tectonic"] }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.autoRefresh": true,
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  "files.autoSave": "off"
}
